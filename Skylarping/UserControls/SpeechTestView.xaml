    Records from the microphone and shows what a speech-to-text server heard.
-->
<UserControl
    x:Class="Skylarping.UserControls.SpeechTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="Tahoma"
    FontSize="11"
    Foreground="{DynamicResource Text.VeryHighContrast}">
    <StackPanel Orientation="Vertical">
        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
            <Button
                x:Name="TestButton"
                Height="23"
                MinWidth="110"
                Padding="12,0"
                Click="TestButton_Click"
                Content="Test Microphone" />
            <TextBlock
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource Text.MediumContrast}"
                Text="5 second transcription test" />
        </StackPanel>
        <TextBlock x:Name="TestResult" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
