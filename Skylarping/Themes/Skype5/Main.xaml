                                            PressedIndex="2"
                                            RightWidth="2"
                                            Source="Assets/Themeable/Main/contacts.png"
                                            StackDirection="Vertical"
                                            Text="{Binding [sZAPBUTTON_CONTACTS], Source={StaticResource Lang}}"
