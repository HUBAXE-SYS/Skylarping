                                            TextLeftMargin="30"
                                            TextSize="13"
                                            TextWeight="Bold" />
                                        <global:SliceControl
                                            x:Name="btnRecents"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            ButtonStateOnInit="Pressed"
                                            DefaultIndex="1"
                                            ElementCount="5"
                                            HoverIndex="-1"
