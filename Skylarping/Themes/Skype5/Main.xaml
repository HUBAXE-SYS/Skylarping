                                            <RowDefinition Height="31" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <global:SliceControl
                                            x:Name="PseudoSearchBox"
                                            Grid.Row="0"
                                            HorizontalAlignment="Stretch"
                                            Cursor="IBeam"
                                            DefaultIndex="1"
                                            ElementCount="2"
                                            HoverIndex="-1"
                                            Interactive="False"
                                            PressedIndex="0"
                                            Source="Assets/Themeable/Main/search-box.png"
                                            StackDirection="Vertical" />
                                        <TextBox
                                            x:Name="SearchBox"
                                            Grid.Row="0"
                                            Padding="33,0,0,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="IBeam"
                                            FontFamily="Tahoma"
                                            FontSize="11"
                                            GotKeyboardFocus="SearchBox_Focused"
                                            LostKeyboardFocus="SearchBox_Unfocused" />
                                        <Rectangle
                                            Grid.Row="1"
                                            Height="1"
                                            Fill="{DynamicResource Sidebar.Divider.Opaque}" />
                                        <ListBox
                                            x:Name="ConversationList"
                                            Grid.Row="2"
                                            BorderThickness="0"
                                            PreviewMouseLeftButtonUp="ConversationList_ItemClicked"
