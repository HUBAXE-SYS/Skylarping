                                        Source="Assets/Themeable/Main/close.png" />
                                </Grid>
                                <Grid
                                    x:Name="HomeTopbar"
                                    Grid.Row="0"
                                    Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <global:SliceControl
                                        x:Name="MainPageButton"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        ButtonStateOnInit="Pressed"
                                        DefaultIndex="0"
                                        ElementCount="5"
                                        HoverIndex="-1"
                                        IsRadioButton="True"
                                        PressedIndex="2"
                                        Source="Assets/Themeable/Main/tab-left.png"
                                        StackDirection="Vertical"
                                        Text="{Binding Source={StaticResource Lang}, Path=[sZAPBUTTON_SKYPEHOME]}"
                                        TextColor="{DynamicResource Text.HighContrast}"
                                        TextFont="Arial"
                                        TextLeftMargin="31"
                                        TextRightMargin="16"
                                        TextSize="13"
                                        TextWeight="Bold" />
                                    <Image
                                        Grid.Column="0"
                                        Width="16"
                                        Height="16"
                                        Margin="8,0,0,0"
                                        HorizontalAlignment="Left"
                                        IsHitTestVisible="False"
                                        Source="Assets/Universal/Main/skypehome.png" />
                                    <global:SliceControl
                                        Grid.Column="3"
                                        HorizontalAlignment="Stretch"
                                        DefaultIndex="0"
                                        ElementCount="5"
                                        HoverIndex="-1"
                                        PressedIndex="-1"
                                        Source="Assets/Themeable/Main/tab-right.png"
                                        StackDirection="Vertical" />
                                </Grid>
                                <Border
                                    Grid.Row="1"
                                    Background="{DynamicResource Card.Background}"
                                    BorderBrush="{DynamicResource Card.Border}"
                                    BorderThickness="1,0,1,1"
                                    CornerRadius="0,0,4,4">
                                    <Grid>
                                        <!--  Home: Skype 5 keeps your picture and mood message here, not in the sidebar  -->
                                        <Grid x:Name="Home" Visibility="Collapsed">
                                            <!--  The footer art has a white background, so Home must be white too  -->
                                            <Rectangle Fill="White" />
                                            <Image
                                                Width="650"
                                                Height="190"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Source="Assets/Universal/Home/footer.png" />
                                            <Grid
                                                x:Name="ProfileGrid"
                                                Margin="20"
                                                VerticalAlignment="Top">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" MaxWidth="500" />
                                                </Grid.ColumnDefinitions>
                                                <!--  TODO: lang  -->
                                                <Border
                                                    Width="96"
                                                    Height="96"
                                                    VerticalAlignment="Top"
                                                    Background="#FFFFFF"
                                                    Cursor="Hand"
                                                    MouseLeftButtonUp="SidebarAvatar_Click"
                                                    ToolTip="Change your picture">
                                                    <Border.Effect>
                                                        <DropShadowEffect
                                                            BlurRadius="4"
                                                            Direction="270"
                                                            ShadowDepth="1"
                                                            Color="{DynamicResource Avatar.Shadow}" />
                                                    </Border.Effect>
                                                    <Grid>
                                                        <Image x:Name="SidebarAvatar" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill">
                                                            <Image.Source>
                                                                <MultiBinding Converter="{StaticResource AvatarConverter}">
                                                                    <Binding Path="Avatar" />
                                                                    <Binding Source="unknown" />
                                                                </MultiBinding>
                                                            </Image.Source>
                                                        </Image>
                                                        <Border BorderBrush="{DynamicResource Avatar.Border}" BorderThickness="1" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                                    <TextBlock
                                                        FontFamily="Arial"
                                                        FontSize="18"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource Text.HighContrast}"
                                                        Text="{Binding DisplayName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <Border
                                                        MinHeight="44"
                                                        Margin="0,10,0,0"
                                                        Background="#FFFFFF"
                                                        BorderBrush="{DynamicResource Card.Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="4">
                                                        <TextBox
                                                            x:Name="MoodBox"
                                                            Padding="8,4"
                                                            VerticalContentAlignment="Center"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="IBeam"
                                                            FontFamily="Tahoma"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource Text.LowContrast}"
                                                            GotKeyboardFocus="MoodBox_GotKeyboardFocus"
                                                            LostKeyboardFocus="MoodBox_LostKeyboardFocus"
                                                            MaxLength="300"
                                                            PreviewKeyDown="MoodBox_PreviewKeyDown"
                                                            TextWrapping="Wrap" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                        <ContentControl x:Name="FillMessagePanelHost" Visibility="Collapsed" />
                                        <ContentControl x:Name="ChatProfileArea" Content="{Binding DataContext, ElementName=ChatArea}">
                                            <ContentControl.Resources>
                                                <DataTemplate DataType="{x:Type models:DirectMessage}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <!--  Profile picture column  -->
                                                        <Image
                                                            x:Name="CPAProfilePic"
                                                            Grid.Column="0"
                                                            Margin="4,4,5,9"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            RenderOptions.BitmapScalingMode="HighQuality"
                                                            Stretch="UniformToFill">
                                                            <Image.Source>
                                                                <MultiBinding Converter="{StaticResource AvatarConverter}">
                                                                    <Binding Path="Avatar" />
                                                                    <Binding Source="user" />
                                                                </MultiBinding>
                                                            </Image.Source>
                                                            <Image.Effect>
                                                                <DropShadowEffect
                                                                    BlurRadius="4"
                                                                    Direction="270"
                                                                    ShadowDepth="1"
                                                                    Color="{DynamicResource Avatar.Shadow}" />
                                                            </Image.Effect>
                                                        </Image>
                                                        <!--  Information column  -->
                                                        <StackPanel
                                                            Grid.Column="1"
                                                            Margin="12,12"
                                                            Orientation="Vertical">
                                                            <!--  Text status row ("I'm bored", etc)  -->
                                                            <StackPanel
                                                                Margin="0,0,0,15"
                                                                HorizontalAlignment="Left"
                                                                Orientation="Horizontal"
                                                                Visibility="{Binding Partner.Status, Converter={StaticResource NullDependentVisibilityConverter}}">
                                                                <Image
                                                                    Width="16"
                                                                    Height="16"
                                                                    Source="Assets/Universal/Main/mood.png" />
                                                                <TextBlock
                                                                    Margin="9,0,0,0"
                                                                    FontFamily="Tahoma"
                                                                    FontSize="11"
                                                                    Text="{Binding Partner.Status, TargetNullValue=''}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <!--  Time row for remote user. TODO: implement this in the backend  -->
                                                            <StackPanel
                                                                x:Name="TimeRow"
                                                                Margin="0,0,0,15"
                                                                HorizontalAlignment="Left"
                                                                Orientation="Horizontal"
                                                                Visibility="Collapsed">
                                                                <Image
                                                                    Width="16"
                                                                    Height="16"
                                                                    Source="Assets/Universal/Main/clock.png" />
                                                                <TextBlock
                                                                    Margin="9,0,0,0"
                                                                    FontFamily="Tahoma"
                                                                    FontSize="11"
                                                                    Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat={}{0:h:mm tt}}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <!--  Connection status row (online, offline, away, dnd)  -->
                                                            <StackPanel
                                                                x:Name="StatusRow"
                                                                HorizontalAlignment="Left"
                                                                Orientation="Horizontal">
                                                                <global:SliceControl
                                                                    Width="14"
                                                                    Height="14"
                                                                    DefaultIndex="{Binding Partner.ConnectionStatus, Converter={StaticResource ConnectionStatusConverter}}"
                                                                    ElementCount="22"
                                                                    Interactive="False"
                                                                    SliceMode="0"
                                                                    Source="Assets/Universal/Icon/skype-status-small.png"
                                                                    StackDirection="Horizontal" />
                                                                <TextBlock
                                                                    Margin="11,0,0,0"
                                                                    FontFamily="Tahoma"
                                                                    FontSize="11"
                                                                    Text="{Binding Partner.ConnectionStatus, Converter={StaticResource StatIntToText}}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                                <DataTemplate DataType="{x:Type models:Group}">
                                                    <ItemsControl ItemsSource="{Binding Members}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type models:User}">
                                                                <StackPanel
                                                                    Width="120"
                                                                    Margin="10,0"
                                                                    Orientation="Vertical">
                                                                    <!--  Name row with status icon  -->
                                                                    <StackPanel
                                                                        Margin="0,0,0,2"
                                                                        HorizontalAlignment="Center"
                                                                        Orientation="Horizontal">
                                                                        <global:SliceControl
                                                                            Width="16"
                                                                            Height="16"
                                                                            VerticalAlignment="Center"
                                                                            DefaultIndex="{Binding ConnectionStatus, Converter={StaticResource ConnectionStatusConverter}}"
                                                                            ElementCount="22"
                                                                            Interactive="False"
                                                                            SliceMode="0"
                                                                            Source="Assets/Universal/Icon/skype-status.png"
                                                                            StackDirection="Horizontal" />
                                                                        <TextBlock
                                                                            MaxWidth="100"
                                                                            Margin="5,0,0,1"
                                                                            VerticalAlignment="Center"
                                                                            FontFamily="Tahoma"
                                                                            FontSize="11"
                                                                            Foreground="{DynamicResource Text.VeryHighContrast}"
                                                                            Text="{Binding DisplayName}"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            TextWrapping="NoWrap" />
                                                                    </StackPanel>
                                                                    <!--  Profile picture  -->
                                                                    <Image
                                                                        Width="85"
                                                                        Margin="0,3,0,0"
                                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                                        Stretch="UniformToFill">
                                                                        <Image.Source>
                                                                            <MultiBinding Converter="{StaticResource AvatarConverter}">
                                                                                <Binding Path="Avatar" />
                                                                                <Binding Source="user" />
                                                                            </MultiBinding>
                                                                        </Image.Source>
                                                                        <Image.Effect>
                                                                            <DropShadowEffect
                                                                                BlurRadius="4"
                                                                                Direction="270"
                                                                                ShadowDepth="1"
                                                                                Color="{DynamicResource Avatar.Shadow}" />
                                                                        </Image.Effect>
                                                                    </Image>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DataTemplate>
                                            </ContentControl.Resources>
                                        </ContentControl>
                                    </Grid>
                                </Border>
                                <Rectangle
                                    x:Name="ChatTopBarSplitter"
                                    Grid.Row="2"
                                    Cursor="SizeNS"
                                    Fill="Transparent"
                                    MouseLeftButtonDown="ChatTopBarSplitter_Press"
                                    MouseMove="ChatTopBarSplitter_MouseMove" />
                                <Border
                                    x:Name="MessageWindow"
                                    Grid.Row="3"
                                    Background="{DynamicResource Card.Background}"
                                    BorderBrush="{DynamicResource Card.Border}"
                                    BorderThickness="1,1,1,1"
                                    CornerRadius="4,4,4,4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition x:Name="ChatButtonRow" Height="34" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="20" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel
                                            Grid.Row="0"
                                            Margin="7,1,0,0"
                                            HorizontalAlignment="Left"
                                            Orientation="Horizontal">
                                            <!--  TODO change event to something like Command="{Binding DataContext.CallCommand, RelativeSource={RelativeSource AncestorType=Window}}"  -->
                                            <global:SliceControl
                                                x:Name="CallButton"
                                                Width="Auto"
                                                DefaultIndex="0"
                                                ElementCount="5"
                                                HoverIndex="1"
                                                LeftWidth="23"
                                                MouseLeftButtonUp="CallButtonClick"
                                                PressedIndex="2"
                                                RightWidth="4"
                                                Source="Assets/Universal/Main/btn_call_left.png"
                                                StackDirection="Vertical"
                                                Text="{Binding Source={StaticResource Lang}, Path=[sZAPBUTTON_CALL]}"
                                                TextColor="White"
                                                TextFont="Arial"
                                                TextLeftMargin="26"
                                                TextSize="13"
                                                TextWeight="Bold" />
                                            <global:SliceControl
                                                x:Name="CallDropdown"
                                                MouseLeftButtonUp="CallDropdown_Click"
                                                Width="24"
                                                Margin="0,0,10,0"
                                                DefaultIndex="0"
                                                ElementCount="5"
                                                HoverIndex="1"
                                                LeftWidth="1"
                                                PressedIndex="2"
                                                RightWidth="1"
                                                Source="Assets/Universal/Main/btn_call_right.png"
                                                StackDirection="Vertical" />
                                            <global:SliceControl
                                                x:Name="WifiButton"
                                                Width="44"
                                                Margin="10,0,0,0"
                                                DefaultIndex="0"
                                                ElementCount="5"
                                                HoverIndex="1"
                                                PressedIndex="2"
                                                SliceMode="0"
                                                Source="Assets/Themeable/Main/network-none.png"
                                                StackDirection="Vertical" />
                                        </StackPanel>
                                        <Rectangle
                                            Grid.Row="1"
                                            Height="1"
                                            Fill="{DynamicResource Chatbar.Divider}" />
                                        <Image
                                            x:Name="Spinner"
                                            Grid.Row="2"
                                            Width="90"
                                            Height="90"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            RenderTransformOrigin="0.5,0.5"
                                            Source="Assets/Universal/Animations/spinner.png"
                                            Visibility="Visible">
                                            <Image.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform />
                                                    <SkewTransform />
                                                    <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                                                    <TranslateTransform />
                                                </TransformGroup>
                                            </Image.RenderTransform>
                                            <Image.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation
                                                                RepeatBehavior="Forever"
                                                                Storyboard.TargetName="SpinnerRotate"
                                                                Storyboard.TargetProperty="Angle"
                                                                From="0"
                                                                To="360"
                                                                Duration="0:0:2.133333" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Image.Triggers>
                                        </Image>
                                        <ListBox
                                            x:Name="ConversationItemsList"
                                            Grid.Row="2"
                                            Margin="0,0,0,0"
                                            VerticalAlignment="Bottom"
                                            BorderThickness="0"
                                            Loaded="ConversationItemsList_Loaded"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            Style="{StaticResource NoInsetListBox}"
                                            ScrollViewer.CanContentScroll="False"
                                            mc:Ignorable="d">
                                            <!--  Pixel scrolling (CanContentScroll=False) so long messages can be read part-way.
                                                  .NET 4.0 can't virtualize a pixel-scrolled list; that's fine at the default
                                                  30-message load. The code-behind keeps the view pinned to the newest message.  -->
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="ItemBorder" Background="Transparent">
                                                                    <ContentPresenter />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                        <Grid
                                            Grid.Row="4"
                                            Margin="0,0,0,5"
                                            VerticalAlignment="Bottom">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <global:SliceControl
                                                Grid.Column="1"
                                                BottomHeight="4"
                                                DefaultIndex="0"
                                                ElementCount="7"
                                                SliceMode="2"
                                                Source="Assets/Themeable/Main/message-box-header25.png"
                                                StackDirection="Vertical"
                                                TopHeight="25" />
                                            <StackPanel
                                                x:Name="MessageBoxPanel"
                                                Grid.Column="1"
                                                Width="429"
                                                HorizontalAlignment="Center"
                                                Orientation="Vertical">
                                                <!--  Message box header  -->
                                                <Grid Height="25">
                                                    <StackPanel
                                                        Margin="5,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <global:SliceControl
                                                            x:Name="EmojiButton"
                                                            Width="18"
                                                            Height="18"
                                                            HorizontalAlignment="Left"
                                                            DefaultIndex="0"
                                                            ElementCount="5"
                                                            HoverIndex="1"
                                                            MouseLeftButtonUp="EmojiButton_Click"
                                                            PressedIndex="2"
                                                            SliceMode="0"
                                                            Source="Assets/Themeable/Main/emoji.png"
                                                            StackDirection="Vertical" />
                                                    </StackPanel>
                                                    <Popup
                                                        x:Name="EmojiFlyout"
                                                        AllowsTransparency="True"
                                                        HorizontalOffset="-20"
                                                        Placement="Top"
                                                        PlacementTarget="{Binding ElementName=EmojiButton}"
                                                        StaysOpen="False">
                                                        <Border
                                                            Padding="2"
                                                            Background="{DynamicResource EmojiFlyout.Background}"
                                                            BorderBrush="{DynamicResource EmojiFlyout.Border}"
                                                            BorderThickness="1"
                                                            CornerRadius="4">
                                                            <ScrollViewer
                                                                MaxWidth="257"
                                                                MaxHeight="278"
                                                                HorizontalScrollBarVisibility="Disabled"
                                                                VerticalScrollBarVisibility="Visible">
                                                                <ScrollViewer.Resources>
                                                                    <Style TargetType="ScrollBar">
                                                                        <Setter Property="Width" Value="8" />
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="ScrollBar">
                                                                                    <Grid
                                                                                        Width="8"
                                                                                        HorizontalAlignment="Right"
                                                                                        Background="Transparent">
                                                                                        <Track Name="PART_Track" IsDirectionReversed="True">
                                                                                            <Track.Thumb>
                                                                                                <Thumb Width="6" HorizontalAlignment="Center">
                                                                                                    <Thumb.Template>
                                                                                                        <ControlTemplate TargetType="Thumb">
                                                                                                            <Border
                                                                                                                Width="6"
                                                                                                                HorizontalAlignment="Center"
                                                                                                                Background="White"
                                                                                                                CornerRadius="3"
                                                                                                                Opacity="0.9" />
                                                                                                        </ControlTemplate>
                                                                                                    </Thumb.Template>
                                                                                                </Thumb>
                                                                                            </Track.Thumb>
                                                                                        </Track>
                                                                                    </Grid>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </ScrollViewer.Resources>
                                                                <WrapPanel x:Name="EmojiWrapPanel" Orientation="Horizontal" />
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Popup>
                                                    <StackPanel
                                                        x:Name="TypingIndicator"
                                                        Margin="0,0,7,0"
                                                        HorizontalAlignment="Right"
                                                        Orientation="Horizontal"
                                                        Visibility="Collapsed">
                                                        <global:SliceControl
                                                            x:Name="TypingIndicatorIcon"
                                                            Width="23"
                                                            AnimationFps="30"
                                                            DefaultIndex="0"
                                                            ElementCount="37"
                                                            HoverIndex="-1"
                                                            IsAnimation="True"
                                                            PressedIndex="-1"
                                                            SliceMode="0"
                                                            Source="Assets/Universal/Main/pencil-write.png"
                                                            StackDirection="Vertical" />
                                                        <TextBlock
                                                            x:Name="TypingIndicatorText"
                                                            Margin="3,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="{DynamicResource Text.MediumContrast}" />
                                                    </StackPanel>
                                                </Grid>
                                                <!--  @ tagging in a group: the members, filtered as you type  -->
                                                <Popup
                                                    x:Name="MentionPopup"
                                                    AllowsTransparency="True"
                                                    Placement="Top"
                                                    PlacementTarget="{Binding ElementName=MessageTextBox}"
                                                    StaysOpen="True">
                                                    <Border
                                                        Background="White"
                                                        BorderBrush="{DynamicResource Text.LowContrast}"
                                                        BorderThickness="1">
                                                        <ListBox
                                                            x:Name="MentionList"
                                                            MinWidth="180"
                                                            MaxHeight="150"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Focusable="False"
                                                            PreviewMouseLeftButtonUp="MentionList_Click"
                                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                            <ListBox.ItemContainerStyle>
                                                                <Style TargetType="{x:Type ListBoxItem}">
                                                                    <Setter Property="Focusable" Value="False" />
                                                                </Style>
                                                            </ListBox.ItemContainerStyle>
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type models:User}">
                                                                    <StackPanel Margin="2" Orientation="Horizontal">
                                                                        <Image
                                                                            Width="20"
                                                                            Height="20"
                                                                            Margin="0,0,5,0"
                                                                            RenderOptions.BitmapScalingMode="HighQuality"
                                                                            Stretch="UniformToFill">
                                                                            <Image.Source>
                                                                                <MultiBinding Converter="{StaticResource AvatarConverter}">
                                                                                    <Binding Path="Avatar" />
                                                                                    <Binding Source="user" />
                                                                                </MultiBinding>
                                                                            </Image.Source>
                                                                        </Image>
                                                                        <TextBlock
                                                                            VerticalAlignment="Center"
                                                                            FontFamily="Tahoma"
                                                                            FontSize="11"
                                                                            Text="{Binding DisplayName}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </Border>
                                                </Popup>
                                                <!--  Message box typing area  -->
                                                <RichTextBox
                                                    x:Name="MessageTextBox"
                                                    MinHeight="35"
                                                    MaxHeight="{Binding ActualHeight, ElementName=MessageWindow, Converter={StaticResource HalfValueConverter}}"
                                                    Padding="2,3"
                                                    AcceptsReturn="True"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontFamily="Tahoma"
                                                    FontSize="11"
                                                    GotKeyboardFocus="MessageTextBox_Focused"
                                                    LostKeyboardFocus="MessageTextBox_Unfocused"
                                                    PreviewKeyDown="MessageTextBox_PreviewKeyDown"
                                                    SnapsToDevicePixels="True"
                                                    TextChanged="MessageTextBox_TextChanged"
                                                    UseLayoutRounding="True"
                                                    VerticalScrollBarVisibility="Auto">
                                                    <RichTextBox.Document>
                                                        <FlowDocument>
                                                            <Paragraph Margin="0" />
                                                        </FlowDocument>
                                                    </RichTextBox.Document>
                                                </RichTextBox>
                                            </StackPanel>
                                            <global:SliceControl
                                                x:Name="SendMsgButton"
                                                Grid.Column="2"
                                                Width="Auto"
                                                Margin="8,0,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                DefaultIndex="0"
                                                ElementCount="5"
                                                Focusable="False"
                                                HoverIndex="1"
                                                IsEnabled="False"
                                                LeftWidth="22"
                                                MouseLeftButtonUp="OnMsgSendClickButton"
                                                PressedIndex="2"
                                                RightWidth="22"
                                                Source="Assets/Universal/Main/msg-send-button-full.png"
                                                StackDirection="Vertical"
                                                Text="{Binding Source={StaticResource Lang}, Path=[sZAPBUTTON_SENDMESSAGE]}"
                                                TextColor="White"
                                                TextFont="Arial"
                                                TextLeftMargin="26"
                                                TextSize="13"
                                                TextWeight="Bold" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</global:SkinnedMainWindowBase>


