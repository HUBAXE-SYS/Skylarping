                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            Style="{StaticResource NoInsetListBox}">
                                            <ListBox.Resources>
                                                <!--  Right-click menu for contacts and conversations (not date headers)  -->
                                                <ContextMenu x:Key="ConversationItemMenu" x:Shared="False">
                                                    <MenuItem Click="EditCharacter_Click" Header="Edit Character..." />
                                                    <MenuItem Click="ExportCharacter_Click" Header="Export Character..." />
                                                    <MenuItem Click="EditGroup_Click" Header="Edit Group..." />
                                                    <MenuItem Click="ClearChatHistory_Click" Header="Clear Chat History..." />
                                                    <Separator />
                                                    <MenuItem Click="RemoveContact_Click" Header="Remove Contact..." />
                                                    <MenuItem Click="RemoveGroup_Click" Header="Remove Group..." />
                                                </ContextMenu>
                                            </ListBox.Resources>
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Focusable" Value="True" />
                                                    <Setter Property="IsEnabled" Value="True" />
                                                    <Setter Property="ContextMenu" Value="{StaticResource ConversationItemMenu}" />
                                                    <EventSetter Event="ContextMenuOpening" Handler="ConversationItem_ContextMenuOpening" />
                                                    <EventSetter Event="MouseDoubleClick" Handler="ConversationItem_DoubleClick" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="ItemBorder" Background="Transparent">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="ItemBorder" Property="Background">
                                                                            <Setter.Value>
                                                                                <ImageBrush ImageSource="Assets/Themeable/Main/selection-background.png" Stretch="Fill" />
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding}" Value="{x:Type global:DateHeaderItem}">
                                                                        <Setter Property="Focusable" Value="False" />
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="2" Orientation="Vertical">
                                    <Grid x:Name="SidebarAddButtons" Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="117" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <global:SliceControl
                                            x:Name="AddContactButton"
                                            Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            DefaultIndex="0"
                                            ElementCount="3"
                                            HoverIndex="1"
                                            HoverTransition="False"
                                            MouseLeftButtonUp="AddContact_Click"
                                            PressedIndex="2"
                                            Source="Assets/Themeable/Main/add-contact.png"
                                            StackDirection="Vertical"
                                            Style="{StaticResource AddButtonHoverStyle}"
                                            Text="{Binding [sADD_CONTACT_LONG], Source={StaticResource Lang}}"
                                            TextFont="Tahoma"
                                            TextLeftMargin="41"
                                            TextSize="11" />
                                        <global:SliceControl
                                            x:Name="MakeGroupButton"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            DefaultIndex="0"
                                            ElementCount="4"
                                            HoverIndex="1"
                                            HoverTransition="False"
                                            MouseLeftButtonUp="MakeGroup_Click"
                                            PressedIndex="2"
                                            RightWidth="1"
                                            Source="Assets/Themeable/Main/create-group.png"
                                            StackDirection="Vertical"
                                            Style="{StaticResource AddButtonHoverStyle}"
                                            Text="{Binding [sCREATE_GROUP_LONG], Source={StaticResource Lang}}"
                                            TextFont="Tahoma"
                                            TextLeftMargin="41"
                                            TextSize="11" />
                                    </Grid>

                                    <Border BorderBrush="{DynamicResource Card.Border}" BorderThickness="1,0,1,0">
                                        <StackPanel Orientation="Vertical">
                                            <Rectangle Height="1" Fill="{DynamicResource Sidebar.Divider.Translucent}" />
                                            <global:SliceControl
                                                HorizontalAlignment="Stretch"
                                                DefaultIndex="0"
                                                ElementCount="5"
                                                HoverIndex="1"
                                                MouseLeftButtonUp="CallPhones_Click"
                                                PressedIndex="2"
                                                Source="Assets/Themeable/Main/call-phones.png"
                                                StackDirection="Vertical"
                                                Text="{Binding [sZAPBUTTON_SKYPEOUT], Source={StaticResource Lang}}"
                                                TextColor="{DynamicResource Text.HighContrast}"
                                                TextFont="Arial"
                                                TextLeftMargin="32"
                                                TextSize="13"
                                                TextWeight="Bold" />
                                            <Rectangle Height="1" Fill="{DynamicResource Sidebar.Divider.Translucent}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                            </Grid>
                            <ContentControl
                                x:Name="SelectedItemHolder"
                                Grid.Row="0"
                                Visibility="Collapsed" />
                            <Rectangle
                                x:Name="SkypeSplitter"
                                Grid.Column="1"
                                Cursor="SizeWE"
                                Fill="Transparent"
                                MouseLeftButtonDown="SkypeSplitter_Press"
                                MouseMove="SkypeSplitter_MouseMove" />
                            <Grid
                                x:Name="ChatArea"
                                Grid.Column="2"
                                DataContext="{Binding SelectedItem, ElementName=ConversationList}">

                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="ChatTopBarRow" Height="32" />
                                    <RowDefinition
                                        x:Name="TopbarWindowRow"
                                        Height="130"
                                        MinHeight="107"
                                        MaxHeight="171" />
                                    <RowDefinition x:Name="ChatTopbarSplitterRow" Height="4" />
                                    <RowDefinition x:Name="MessageWindowRow" Height="*" />
                                </Grid.RowDefinitions>
                                <Grid
                                    x:Name="ChatTopbar"
                                    Grid.Row="0"
                                    Visibility="Visible">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <global:SliceControl
                                        x:Name="chatHeader"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        DefaultIndex="0"
                                        ElementCount="5"
                                        HoverIndex="-1"
                                        PressedIndex="-1"
                                        Source="Assets/Themeable/Main/tab-left.png"
                                        StackDirection="Vertical"
                                        Text="{Binding DisplayName}"
                                        TextColor="{DynamicResource Text.HighContrast}"
                                        TextFont="Arial"
                                        TextLeftMargin="13"
                                        TextSize="13"
                                        TextWeight="Bold" />
                                    <global:SliceControl
                                        x:Name="ChatCloseButton"
                                        Grid.Column="1"
                                        Width="Auto"
                                        HorizontalAlignment="Stretch"
                                        DefaultIndex="0"
                                        ElementCount="5"
                                        HoverIndex="1"
                                        MouseLeftButtonUp="Chat_Close"
                                        PressedIndex="2"
                                        Source="Assets/Themeable/Main/tab-right.png"
                                        StackDirection="Vertical"
                                        Text="{Binding Source={StaticResource Lang}, Path=[sZAPBUTTON_CLOSE]}"
                                        TextColor="{DynamicResource Text.HighContrast}"
                                        TextFont="Arial"
                                        TextLeftMargin="27"
                                        TextRightMargin="16"
                                        TextSize="13"
                                        TextWeight="Bold" />
                                    <Image
                                        Grid.Column="1"
                                        Width="16"
                                        Height="16"
                                        Margin="7,0,0,0"
                                        HorizontalAlignment="Left"
