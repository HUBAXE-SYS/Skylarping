                                            LeftWidth="25"
                                            MouseLeftButtonUp="SidebarTab_BtnDown"
                                            PressedIndex="2"
                                            RightWidth="2"
                                            Source="Assets/Themeable/Main/recents.png"
                                            StackDirection="Vertical"
                                            Text="{Binding [sRECENTS_TAB_TEXT], Source={StaticResource Lang}}"
                                            TextColor="{DynamicResource Text.HighContrast}"
                                            TextFont="Arial"
                                            TextLeftMargin="30"
                                            TextSize="13"
                                            TextWeight="Bold" />
                                    </Grid>
                                </StackPanel>
                                <Border
                                    Grid.Row="1"
                                    BorderBrush="{DynamicResource Card.Border}"
                                    BorderThickness="1,0,1,0">
                                    <Grid x:Name="ContactsArea">
