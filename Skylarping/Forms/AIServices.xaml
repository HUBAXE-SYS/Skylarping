    Tools > AI Services: the AI backends Skylarping talks to. Same look as Options.
    Today: the language model, Speech-to-Text and Tools (SimpleLLMChat-compatible). Planned
    categories: Text-to-Speech and Image Generation - each gets a header +
    pages here, an entry in catToGrid/tabDispenser and an AI/* settings section.
-->
<Window
    x:Class="Skylarping.Forms.AIServices"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Skylarping.Converters"
    xmlns:global="clr-namespace:Skylarping"
    Width="716"
    Height="612"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    Background="#d4e2f2"
    DataContext="{StaticResource Lang}"
    FontFamily="Tahoma"
    FontSize="11"
    ResizeMode="CanMinimize"
    Style="{StaticResource Window}"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:AssetLoader x:Key="AssetLoader" />

        <Style x:Key="SidebarHeaderStyle" TargetType="global:SliceControl">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ElementCount" Value="5" />
            <Setter Property="DefaultIndex" Value="0" />
            <Setter Property="HoverIndex" Value="1" />
            <Setter Property="PressedIndex" Value="2" />
            <Setter Property="Source" Value="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Themeable/Options/header_background.png}" />
            <Setter Property="IconLeftMargin" Value="10" />
            <Setter Property="IconWidth" Value="24" />
            <Setter Property="IconHeight" Value="24" />
            <Setter Property="IsRadioButton" Value="True" />
            <Setter Property="PressedOffsetY" Value="0" />
            <Setter Property="TextColor" Value="{DynamicResource Text.MediumContrast}" />
            <Setter Property="TextFont" Value="Tahoma" />
            <Setter Property="TextLeftMargin" Value="39" />
            <Setter Property="TextSize" Value="11" />
        </Style>
        <Style x:Key="SidebarItemContainerStyle" TargetType="global:SliceControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="global:SliceControl">
                        <global:SliceControl
                            VerticalAlignment="Stretch"
                            BottomHeight="2"
                            DefaultIndex="4"
                            ElementCount="5"
                            ElementSpan="1"
                            HoverIndex="-1"
                            Interactive="False"
                            PressedIndex="-1"
                            SliceMode="2"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Themeable/Options/header_background.png}"
                            StackDirection="Vertical"
                            TopHeight="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarButtonStyle" TargetType="global:SliceControl">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="IsRadioButton" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="global:SliceControl">
                        <Grid Height="40">
                            <global:SliceControl
                                x:Name="InnerSlice"
                                Margin="4,-1,4,2"
                                Background="#ffffff"
                                BackgroundPressed="{DynamicResource Settings.ActiveTab}"
                                IsRadioButton="True"
                                MouseLeftButtonDown="TabSelect"
                                PressedOffsetY="0"
                                Tag="{Binding RelativeSource={RelativeSource AncestorType=global:SliceControl}}"
                                Text="{TemplateBinding Text}"
                                TextColor="{DynamicResource Text.MediumContrast}"
                                TextColorPressed="{DynamicResource Settings.ActiveTabText}"
                                TextFont="Tahoma"
                                TextLeftMargin="39"
                                TextSize="11" />
                            <Image
                                Height="24"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Source="{TemplateBinding Source}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderThickness="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="182" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,3,0">
                <global:SliceControl
                    x:Name="HLanguageModel"
                    ButtonStateOnInit="Pressed"
                    DefaultIndex="3"
                    HoverIndex="-1"
                    IconHeight="24"
                    IconSource="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/im_and_sms.png}"
                    MouseLeftButtonUp="CatSelect"
                    PressedIndex="-1"
                    Style="{StaticResource SidebarHeaderStyle}"
                    Text="Language Model" />
                <Grid x:Name="GLanguageModel">
                    <global:SliceControl Style="{StaticResource SidebarItemContainerStyle}" />
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,0,0,1"
                        Orientation="Vertical">
                        <global:SliceControl
                            x:Name="LM_Server"
                            ButtonStateOnInit="Pressed"
                            MouseLeftButtonDown="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/connection.png}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Text="Server" />
                        <global:SliceControl
                            x:Name="LM_Display"
                            MouseLeftButtonDown="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/appearance.png}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Text="Chat display" />
                    </StackPanel>
                </Grid>

                <global:SliceControl
                    x:Name="HSpeech"
                    IconHeight="24"
                    IconSource="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/audio.png}"
                    MouseLeftButtonUp="CatSelect"
                    Style="{StaticResource SidebarHeaderStyle}"
                    Text="Speech" />
                <Grid x:Name="GSpeech" Visibility="Collapsed">
                    <global:SliceControl Style="{StaticResource SidebarItemContainerStyle}" />
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,0,0,1"
                        Orientation="Vertical">
                        <global:SliceControl
                            x:Name="STT_Server"
                            MouseLeftButtonDown="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/connection.png}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Text="Speech-to-Text" />
                        <global:SliceControl
                            x:Name="TTS_Server"
                            MouseLeftButtonDown="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/connection.png}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Text="Text-to-Speech" />
                    </StackPanel>
                </Grid>

                <global:SliceControl
                    x:Name="HTools"
                    IconHeight="24"
                    IconSource="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/advanced.png}"
                    MouseLeftButtonUp="CatSelect"
                    Style="{StaticResource SidebarHeaderStyle}"
                    Text="Tools" />
                <Grid x:Name="GTools" Visibility="Collapsed">
                    <global:SliceControl Style="{StaticResource SidebarItemContainerStyle}" />
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,0,0,1"
                        Orientation="Vertical">
                        <global:SliceControl
                            x:Name="T_Settings"
                            MouseLeftButtonDown="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/general.png}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Text="Tool settings" />
                        <global:SliceControl
                            x:Name="T_Timeouts"
                            MouseLeftButtonDown="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/alerts.png}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Text="Timeouts" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <global:SliceControl
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        BottomHeight="3"
                        DefaultIndex="3"
                        ElementCount="5"
                        ElementSpan="2"
                        Interactive="False"
                        SliceMode="2"
                        Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Themeable/Options/header_background.png}"
                        StackDirection="Vertical"
                        TopHeight="37" />
                    <StackPanel
                        Margin="10,12,0,6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Panel.ZIndex="2"
                        Orientation="Horizontal">
                        <TextBlock
                            x:Name="CTabTitle"
                            FontFamily="Tahoma"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Text.HighContrast}" />
                        <TextBlock
                            x:Name="CTabDescription"
                            Margin="7,0"
                            FontFamily="Tahoma"
                            FontSize="11"
                            Foreground="{DynamicResource Text.HighContrast}" />
                    </StackPanel>
                    <Frame
                        x:Name="PageHost"
                        Margin="5,40,5,5"
                        NavigationUIVisibility="Hidden" />
                </Grid>

                <DockPanel
                    Grid.Row="1"
                    Height="23"
                    Margin="0,10,3,3"
                    LastChildFill="False">
                    <Button
                        Height="23"
                        MinWidth="73"
                        Padding="12,0"
                        Click="WizardButtonClick"
                        Content="Connection Wizard..."
                        DockPanel.Dock="Left"
                        FontSize="11" />
                    <Button
                        Height="23"
                        MinWidth="73"
                        Padding="12,0"
                        Click="CancelButtonClick"
                        Content="{Binding [sF_OPTIONS_BUTTON_CANCEL]}"
                        DockPanel.Dock="Right"
                        FontSize="11" />
                    <Button
                        Height="23"
                        MinWidth="73"
                        Margin="0,0,12,0"
                        Padding="12,0"
                        Click="SaveButtonClick"
                        Content="{Binding [sF_OPTIONS_BUTTON_SAVE]}"
                        DockPanel.Dock="Right"
                        FontSize="11"
                        IsDefault="True" />
                </DockPanel>

            </Grid>
        </Grid>
    </Border>
</Window>
