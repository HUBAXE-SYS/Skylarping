    Add a contact = create a character, or import a SillyTavern
    character card (PNG/JSON) to prefill the form and edit it.
-->
<Page
    x:Class="Skylarping.Forms.Pages.AddContact"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Add a contact"
    d:Background="#FFFFFF"
    d:Height="560"
    d:Width="580"
    FontFamily="Tahoma"
    FontSize="11"
    Foreground="{DynamicResource Text.VeryHighContrast}"
    Style="{StaticResource Page}"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="FieldHint" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Foreground" Value="{DynamicResource Text.MediumContrast}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="LongText" TargetType="{x:Type TextBox}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontFamily" Value="Tahoma" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="False" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="SpellCheck.IsEnabled" Value="False" />
            <EventSetter Event="PreviewMouseWheel" Handler="LongText_PreviewMouseWheel" />
        </Style>
        <Style x:Key="ShortText" TargetType="{x:Type TextBox}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontFamily" Value="Tahoma" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Page.Resources>

    <TabControl
        x:Name="MainTabControl"
        Background="Transparent"
        BorderThickness="0"
        SelectedIndex="0">

        <!--  Step 1: the character editor  -->
        <TabItem d:Visibility="Visible" Visibility="Collapsed">
            <ScrollViewer
                x:Name="FormScroller"
                Padding="0,0,10,0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical">

                    <!--  Import  -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Text="Create a character below, or import a SillyTavern character card (.png or .json) to fill in the form. You can change anything before adding them."
                            TextWrapping="Wrap" />
                        <Button
                            Grid.Column="1"
                            Height="23"
                            MinWidth="100"
                            Padding="12,0"
                            VerticalAlignment="Center"
                            Click="ImportButton_Click"
                            Content="Import Card..." />
                    </Grid>
                    <TextBlock
                        x:Name="ImportInfo"
                        Margin="0,0,0,8"
                        Style="{StaticResource FieldHint}"
                        Visibility="Collapsed" />

                    <Separator Margin="0,0,0,10" Foreground="{DynamicResource Separator}" />

                    <!--  Picture + name  -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <Border
                                Width="96"
                                Height="96"
                                HorizontalAlignment="Left"
                                BorderBrush="{DynamicResource Card.Border}"
                                BorderThickness="1">
                                <Image
                                    x:Name="AvatarPreview"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Stretch="UniformToFill" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Name:" />
                            <TextBox
                                x:Name="NameBox"
                                Style="{StaticResource ShortText}"
                                TextChanged="NameBox_TextChanged" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Picture:" />
                            <WrapPanel Orientation="Horizontal">
                                <Button
                                    Height="23"
                                    MinWidth="100"
                                    Margin="0,0,6,4"
                                    Padding="10,0"
                                    Click="ChangePicture_Click"
                                    Content="Change Picture..." />
                                <Button
                                    x:Name="CardPictureButton"
                                    Height="23"
                                    Margin="0,0,6,4"
                                    Padding="10,0"
                                    Click="CardPicture_Click"
                                    Content="Use Card Picture"
                                    IsEnabled="False" />
                                <Button
                                    x:Name="RemovePictureButton"
                                    Height="23"
                                    Margin="0,0,6,4"
                                    Padding="10,0"
                                    Click="RemovePicture_Click"
                                    Content="Remove"
                                    IsEnabled="False" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <!--  The fields that matter most: who they are and how they talk  -->
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Description:" />
                    <TextBlock Style="{StaticResource FieldHint}" Text="Who they are: appearance, background, personality. Most cards put nearly everything here." />
                    <TextBox
                        x:Name="DescriptionBox"
                        Height="110"
                        Style="{StaticResource LongText}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Personality:" />
                    <TextBlock Style="{StaticResource FieldHint}" Text="A short summary of their personality." />
                    <TextBox
                        x:Name="PersonalityBox"
                        Height="60"
                        Style="{StaticResource LongText}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Example dialogue:" />
                    <TextBlock Style="{StaticResource FieldHint}" Text="Shows how they talk. Start each example with &lt;START&gt;, then lines like {{user}}: Hi! and {{char}}: Hello there." />
                    <TextBox
                        x:Name="ExamplesBox"
                        Height="130"
                        Style="{StaticResource LongText}" />

                    <!--  Greetings are optional: off unless the user wants scene-style openers  -->
                    <CheckBox
                        x:Name="UseGreetingBox"
                        Margin="0,0,0,8"
                        Checked="UseGreetingBox_Changed"
                        Content="Greet me when a new chat starts"
                        Unchecked="UseGreetingBox_Changed" />
                    <StackPanel
                        x:Name="GreetingPanel"
                        Margin="18,0,0,0"
                        Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="First message:" />
                        <TextBlock
                            x:Name="GreetingHint"
                            Style="{StaticResource FieldHint}"
                            Text="What they say to open a new conversation." />
                        <TextBox
                            x:Name="FirstMessageBox"
                            Height="60"
                            Style="{StaticResource LongText}" />
                    </StackPanel>

                    <!--  Scenario is optional too: characters are companions, not a scene  -->
                    <CheckBox
                        x:Name="UseScenarioBox"
                        Margin="0,0,0,8"
                        Checked="UseScenarioBox_Changed"
                        Content="Use a scenario (sets the scene for every chat)"
                        Unchecked="UseScenarioBox_Changed" />
                    <StackPanel
                        x:Name="ScenarioPanel"
                        Margin="18,0,0,0"
                        Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Scenario:" />
                        <TextBlock Style="{StaticResource FieldHint}" Text="Where and when the chat takes place, e.g. {{user}} just moved in next door." />
                        <TextBox
                            x:Name="ScenarioBox"
                            Height="60"
                            Style="{StaticResource LongText}" />
                    </StackPanel>

                    <!--  Messaging first: the character writes on their own when the chat goes quiet  -->
                    <CheckBox
                        x:Name="ProactiveBox"
                        Margin="0,0,0,8"
                        Checked="ProactiveBox_Changed"
                        Content="Message me on their own when we haven't talked for a while"
                        Unchecked="ProactiveBox_Changed" />
                    <StackPanel
                        x:Name="ProactivePanel"
                        Margin="18,0,0,10"
                        Visibility="Collapsed">
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Text="After" />
                            <TextBox x:Name="ProactiveMinBox" Grid.Column="1" Margin="0" Style="{StaticResource ShortText}" />
                            <TextBlock Grid.Column="2" Margin="6,0,6,0" VerticalAlignment="Center" Text="to" />
                            <TextBox x:Name="ProactiveMaxBox" Grid.Column="3" Margin="0" Style="{StaticResource ShortText}" />
                            <TextBlock Grid.Column="4" Margin="6,0,0,0" VerticalAlignment="Center" Text="minutes of quiet (picked at random each time)" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldHint}" Text="Not while you're on a call with them, and not more than 3 times in a row if you don't answer." />
                    </StackPanel>

                    <!--  Mood message: the character writes a new one now and then  -->
                    <CheckBox
                        x:Name="UpdateMoodBox"
                        Margin="0,0,0,8"
                        Checked="UpdateMoodBox_Changed"
                        Content="Update their mood message on their own"
                        Unchecked="UpdateMoodBox_Changed" />
                    <StackPanel
                        x:Name="MoodPanel"
                        Margin="18,0,0,10"
                        Visibility="Collapsed">
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Text="Every" />
                            <TextBox x:Name="MoodMinBox" Grid.Column="1" Margin="0" Style="{StaticResource ShortText}" />
                            <TextBlock Grid.Column="2" Margin="6,0,6,0" VerticalAlignment="Center" Text="to" />
                            <TextBox x:Name="MoodMaxBox" Grid.Column="3" Margin="0" Style="{StaticResource ShortText}" />
                            <TextBlock Grid.Column="4" Margin="6,0,0,0" VerticalAlignment="Center" Text="hours (picked at random each time)" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldHint}" Text="They write one when they're added either way." />
                    </StackPanel>

                    <!--  No action text: no *smiles* / *waves* narration (always on during calls)  -->
                    <CheckBox
                        x:Name="SuppressActionsBox"
                        Margin="0,0,0,10"
                        Content="No action text (*smiles*, *waves*)" />

                    <!--  Lorebook: facts that are only sent when their keywords come up  -->
                    <Expander
                        x:Name="LoreExpander"
                        Margin="0,0,0,10"
                        Header="Lorebook">
                        <StackPanel Margin="0,8,0,0" Orientation="Vertical">
                            <TextBlock Style="{StaticResource FieldHint}" Text="Facts the character knows. An entry is only added to the conversation while one of its keywords appears in the recent messages, so they can know a lot without using up the model's memory." />
                            <CheckBox
                                x:Name="UseLorebookBox"
                                Margin="0,4,0,8"
                                Content="Use the lorebook"
                                IsChecked="True" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ListBox
                                    x:Name="LoreList"
                                    Grid.Column="0"
                                    Height="110"
                                    FontFamily="Tahoma"
                                    FontSize="11"
                                    SelectionChanged="LoreList_SelectionChanged" />
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <Button
                                        Height="23"
                                        MinWidth="90"
                                        Margin="0,0,0,4"
                                        Padding="8,0"
                                        Click="LoreAdd_Click"
                                        Content="Add Entry" />
                                    <Button
                                        x:Name="LoreRemoveButton"
                                        Height="23"
                                        MinWidth="90"
                                        Padding="8,0"
                                        Click="LoreRemove_Click"
                                        Content="Remove Entry"
                                        IsEnabled="False" />
                                </StackPanel>
                            </Grid>

                            <!--  The selected entry  -->
                            <StackPanel x:Name="LoreEditor" IsEnabled="False">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Entry name (only shown here):" />
                                <TextBox x:Name="LoreNameBox" Style="{StaticResource ShortText}" LostFocus="LoreField_LostFocus" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Keywords (comma-separated):" />
                                <TextBox x:Name="LoreKeysBox" Style="{StaticResource ShortText}" LostFocus="LoreField_LostFocus" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Content:" />
                                <TextBox
                                    x:Name="LoreContentBox"
                                    Height="80"
                                    LostFocus="LoreField_LostFocus"
                                    Style="{StaticResource LongText}" />

                                <WrapPanel Margin="0,0,0,6">
                                    <CheckBox x:Name="LoreEnabledBox" Margin="0,0,14,4" Content="Enabled" Click="LoreField_Changed" />
                                    <CheckBox x:Name="LoreConstantBox" Margin="0,0,14,4" Content="Always include" Click="LoreField_Changed" />
                                    <CheckBox x:Name="LoreCaseBox" Margin="0,0,14,4" Content="Match case" Click="LoreField_Changed" />
                                    <CheckBox x:Name="LoreRegexBox" Margin="0,0,14,4" Content="Keywords are regular expressions" Click="LoreField_Changed" />
                                </WrapPanel>

                                <CheckBox
                                    x:Name="LoreSelectiveBox"
                                    Margin="0,0,0,4"
                                    Click="LoreField_Changed"
                                    Content="Also require one of these keywords (comma-separated):" />
                                <TextBox x:Name="LoreSecondaryBox" Style="{StaticResource ShortText}" LostFocus="LoreField_LostFocus" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Text="Order:" />
                                    <TextBox x:Name="LoreOrderBox" Grid.Column="1" Margin="0" Style="{StaticResource ShortText}" LostFocus="LoreField_LostFocus" />
                                    <TextBlock Grid.Column="2" Margin="12,0,6,0" VerticalAlignment="Center" Text="Priority:" />
                                    <TextBox x:Name="LorePriorityBox" Grid.Column="3" Margin="0" Style="{StaticResource ShortText}" LostFocus="LoreField_LostFocus" />
                                    <TextBlock Grid.Column="4" Margin="12,0,6,0" VerticalAlignment="Center" Text="Place:" />
                                    <ComboBox x:Name="LorePositionBox" Grid.Column="5" SelectionChanged="LorePosition_Changed">
                                        <ComboBoxItem Content="Before the description" />
                                        <ComboBoxItem Content="After the description" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock Margin="0,0,0,10" Style="{StaticResource FieldHint}" Text="Lower order goes first. When too many entries match, lower priority entries are left out first." />
                            </StackPanel>

                            <Separator Margin="0,0,0,8" Foreground="{DynamicResource Separator}" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Text="Search the last" />
                                <TextBox x:Name="LoreDepthBox" Grid.Column="1" Margin="0" Style="{StaticResource ShortText}" />
                                <TextBlock Grid.Column="2" Margin="6,0,6,0" VerticalAlignment="Center" Text="messages. Token budget:" />
                                <TextBox x:Name="LoreBudgetBox" Grid.Column="3" Margin="0" Style="{StaticResource ShortText}" />
                            </Grid>
                            <TextBlock Style="{StaticResource FieldHint}" Text="Leave blank for the defaults: 4 messages, and a quarter of the model's context window." />
                            <CheckBox
                                x:Name="LoreRecursiveBox"
                                Margin="0,4,0,0"
                                Content="Entries can trigger other entries (recursive scanning)" />
                        </StackPanel>
                    </Expander>

                    <!--  Tools: SimpleLLMChat-compatible tools the character may use, out of sight  -->
                    <Expander
                        x:Name="ToolsExpander"
                        Margin="0,0,0,10"
                        Header="Tools">
                        <StackPanel Margin="0,8,0,0" Orientation="Vertical">
                            <TextBlock Style="{StaticResource FieldHint}" Text="Things the character can do while writing a reply, like looking something up on the web or remembering what you tell them. Tool use isn't shown in the chat. Your model has to support tool calling; tool settings are in Tools &gt; AI Services." />
                            <StackPanel x:Name="ToolsPanel" Margin="0,4,0,0" Orientation="Vertical" />
                        </StackPanel>
                    </Expander>

                    <!--  Less important card fields, kept so imported cards keep them  -->
                    <Expander
                        x:Name="MoreExpander"
                        Margin="0,0,0,10"
                        Header="More card fields (prompts, notes)">
                        <StackPanel Margin="0,8,0,0" Orientation="Vertical">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="System prompt:" />
                            <TextBlock Style="{StaticResource FieldHint}" Text="Replaces the default system prompt for this character. Leave blank to use the default." />
                            <TextBox
                                x:Name="SystemPromptBox"
                                Height="60"
                                Style="{StaticResource LongText}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Post-history instructions:" />
                            <TextBlock Style="{StaticResource FieldHint}" Text="Sent after the chat history, just before they reply." />
                            <TextBox
                                x:Name="PostHistoryBox"
                                Height="45"
                                Style="{StaticResource LongText}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Creator's notes:" />
                            <TextBlock Style="{StaticResource FieldHint}" Text="Not sent to the model." />
                            <TextBox
                                x:Name="CreatorNotesBox"
                                Height="60"
                                Style="{StaticResource LongText}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Tags (comma-separated):" />
                            <TextBox x:Name="TagsBox" Style="{StaticResource ShortText}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Creator:" />
                                    <TextBox x:Name="CreatorBox" Style="{StaticResource ShortText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Version:" />
                                    <TextBox x:Name="VersionBox" Style="{StaticResource ShortText}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!--
                        FUTURE: "Voice sample" section goes here, for voice cloning: import an
                        audio clip (or record one) and play it back. Saved as voice.wav next to
                        card.json, see Characters/CharacterStore.cs. Not implemented yet.
                    -->

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!--  Step 2: done  -->
        <TabItem d:Visibility="Visible" Visibility="Collapsed">
            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <Border
                    Width="64"
                    Height="64"
                    VerticalAlignment="Top"
                    BorderBrush="{DynamicResource Card.Border}"
                    BorderThickness="1">
                    <Image
                        x:Name="DoneAvatar"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Stretch="UniformToFill" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Top">
                    <TextBlock
                        x:Name="DoneCaption"
                        Margin="0,0,0,6"
                        FontWeight="Bold"
                        TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource FieldHint}" Text="They're now in your contact list." />
                </StackPanel>
            </StackPanel>
        </TabItem>
    </TabControl>
</Page>
