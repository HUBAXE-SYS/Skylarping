    Edit Message: change the text of a message in a character chat.
-->
<Page
    x:Class="Skylarping.Forms.Pages.EditMessageText"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="#FFFFFF"
    d:Height="260"
    d:Width="420"
    FontFamily="Tahoma"
    FontSize="11"
    Foreground="{DynamicResource Text.VeryHighContrast}"
    Style="{StaticResource Page}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,6"
            Foreground="{DynamicResource Text.MediumContrast}"
            Text="The character remembers the conversation as you edit it."
            TextWrapping="Wrap" />
        <TextBox
            x:Name="EditBox"
            Grid.Row="1"
            AcceptsReturn="True"
            FontFamily="Tahoma"
            FontSize="11"
            SpellCheck.IsEnabled="False"
            TextChanged="TextBox_TextChanged"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
    </Grid>
</Page>
