<Page
    x:Class="Skylarping.Forms.OptionPages.General.Main"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Skylarping.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:global="clr-namespace:Skylarping"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:preferences="clr-namespace:Skylarping.Preferences"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    d:Background="#FFFFFF"
    d:Height="505"
    d:Width="514"
    DataContext="{StaticResource Lang}"
    FontFamily="Tahoma"
    FontSize="11"
    Foreground="{DynamicResource Text.VeryHighContrast}"
    Style="{StaticResource Page}"
    mc:Ignorable="d">

    <ScrollViewer Margin="10">
        <StackPanel Orientation="Vertical">

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <CheckBox
Margin="0,5"
Padding="6, 0"
Content="{Binding [sF_OPTIONS_LB_1]}"
Foreground="{DynamicResource Text.VeryHighContrast}"
IsChecked="{Binding Path=[DoubleClickStartsCall], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />
            </StackPanel>

            <Separator Margin="2,2,5,2" Foreground="{DynamicResource Separator}" />

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <CheckBox
x:Name="AutoAwayBox"
Margin="0,5"
Padding="6, 0"
VerticalAlignment="Center"
Content="{Binding [sF_OPTIONS_LB_2]}"
Foreground="{DynamicResource Text.VeryHighContrast}"
IsChecked="{Binding Path=[AutoAway], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />
                <TextBox
                    x:Name="AutoAwayMinutesBox"
                    Width="36"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="Tahoma"
                    FontSize="11"
                    IsEnabled="{Binding IsChecked, ElementName=AutoAwayBox}"
                    LostFocus="AutoAwayMinutesBox_LostFocus"
                    MaxLength="3"
                    PreviewTextInput="AutoAwayMinutesBox_PreviewTextInput"
                    TextAlignment="Right" />
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding [sF_OPTIONS_LB_3]}" />
            </StackPanel>

            <Separator Margin="2,2,5,2" Foreground="{DynamicResource Separator}" />

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <CheckBox
Margin="0,5"
Padding="6, 0"
Content="{Binding [sF_USERENTRY_CB_START_SKYPE]}"
Foreground="{DynamicResource Text.VeryHighContrast}"
IsChecked="{Binding Path=[AutoLaunch], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />
            </StackPanel>

            <Separator Margin="2,2,5,2" Foreground="{DynamicResource Separator}" />


            <StackPanel Margin="0,5" Orientation="Horizontal">
                <TextBlock
                    Padding="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="{Binding [sF_USERINFO_LABEL_LANGUAGE]}" />
                            <ComboBox
                    Width="250"
                    DisplayMemberPath="Key"
                    ItemsSource="{Binding Languages}"
                    SelectedValue="{Binding Path=[Language], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}"
                    SelectedValuePath="Key"
                                SelectionChanged="OnLanguageSelectionChanged"/>
            </StackPanel>

            <Separator Margin="2,2,5,2" Foreground="{DynamicResource Separator}" />

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <CheckBox
Margin="0,5"
Padding="6, 0"
Content="{Binding [sOPTIONS_DISPLAY_AVATARS]}"
Foreground="{DynamicResource Text.VeryHighContrast}"
IsChecked="False"
IsEnabled="False"/>
            </StackPanel>



            <Separator Margin="2,8,5,6" Foreground="{DynamicResource Separator}" />
            <!--  TODO: lang  -->
            <TextBlock Margin="0,0,0,3" FontWeight="Bold" Foreground="{DynamicResource Text.VeryHighContrast}" Text="My picture" />
            <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                <Border
                    Width="64"
                    Height="64"
                    VerticalAlignment="Top"
                    Background="#FFFFFF"
                    BorderBrush="{DynamicResource Avatar.Border}"
                    BorderThickness="1">
                    <Image
                        x:Name="PicturePreview"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Stretch="UniformToFill" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Top">
                    <Button
                        MinWidth="130"
                        Padding="8,2"
                        HorizontalAlignment="Left"
                        Click="ChangePicture_Click"
                        Content="{Binding [sCHANGE_MY_PICTURE]}" />
                    <Button
                        x:Name="RemovePictureButton"
                        MinWidth="130"
                        Margin="0,5,0,0"
                        Padding="8,2"
                        HorizontalAlignment="Left"
                        Click="RemovePicture_Click"
                        Content="Remove Picture" />
                </StackPanel>
            </StackPanel>

            <Separator Margin="2,8,5,6" Foreground="{DynamicResource Separator}" />
            <TextBlock Margin="0,0,0,3" FontWeight="Bold" Foreground="{DynamicResource Text.VeryHighContrast}" Text="About me" />
            <TextBlock
                Margin="0,0,0,4"
                Foreground="{DynamicResource Text.MediumContrast}"
                Text="What your characters know about you: who you are, what you like, anything they should remember. They also see your status and mood message."
                TextWrapping="Wrap" />
            <TextBox
                x:Name="AboutMeBox"
                Height="90"
                Margin="0,0,5,0"
                AcceptsReturn="True"
                FontFamily="Tahoma"
                FontSize="11"
                LostFocus="AboutMeBox_LostFocus"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />

        </StackPanel>
    </ScrollViewer>
</Page>
