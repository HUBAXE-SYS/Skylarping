<Page
    x:Class="Skylarping.Forms.OptionPages.General.Devices"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    d:Background="#FFFFFF"
    d:Height="505"
    d:Width="514"
    DataContext="{StaticResource Lang}"
    FontFamily="Tahoma"
    FontSize="11"
    Foreground="{DynamicResource Text.VeryHighContrast}"
    Style="{StaticResource Page}"
    mc:Ignorable="d">

    <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                FontWeight="Bold"
                Text="{Binding [sF_OPTIONS_LB20]}" />
            <ComboBox
                x:Name="MicrophoneBox"
                Grid.Row="0"
                Grid.Column="1"
                SelectionChanged="Microphone_Changed" />
            <ProgressBar
                x:Name="LevelBar"
                Grid.Row="1"
                Grid.Column="1"
                Height="10"
                Margin="0,6,0,3"
                Maximum="1"
                Minimum="0" />
            <TextBlock
                x:Name="LevelHint"
                Grid.Row="2"
                Grid.Column="1"
                Foreground="{DynamicResource Text.MediumContrast}"
                Text="Say something: the bar should move while you speak."
                TextWrapping="Wrap" />

            <Separator
                Grid.Row="3"
                Grid.ColumnSpan="2"
                Margin="2,10,5,10"
                Foreground="{DynamicResource Separator}" />

            <TextBlock
                Grid.Row="4"
                Grid.Column="0"
                VerticalAlignment="Center"
                FontWeight="Bold"
                Text="{Binding [sF_OPTIONS_LB21]}" />
            <ComboBox
                x:Name="SpeakerBox"
                Grid.Row="4"
                Grid.Column="1"
                SelectionChanged="Speaker_Changed" />
            <Button
                Grid.Row="5"
                Grid.Column="1"
                Height="23"
                MinWidth="110"
                Margin="0,6,0,0"
                Padding="12,0"
                HorizontalAlignment="Left"
                Click="CheckSpeakers_Click"
                Content="{Binding [sOPTIONS_AUDIO_CHECK_SPEAKERS]}" />
            <StackPanel
                Grid.Row="6"
                Grid.Column="1"
                Margin="0,8,0,0"
                Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="Buffer on calls:" />
                <TextBox
                    x:Name="BufferBox"
                    Width="50"
                    Margin="6,0,4,0"
                    TextChanged="Buffer_Changed" />
                <TextBlock VerticalAlignment="Center" Text="ms (blank = automatic)" />
            </StackPanel>
            <TextBlock
                x:Name="BufferHint"
                Grid.Row="7"
                Grid.Column="1"
                Margin="0,4,0,0"
                Foreground="{DynamicResource Text.MediumContrast}"
                TextWrapping="Wrap" />

            <Separator
                Grid.Row="8"
                Grid.ColumnSpan="2"
                Margin="2,10,5,10"
                Foreground="{DynamicResource Separator}" />

            <TextBlock
                Grid.Row="9"
                Grid.Column="0"
                VerticalAlignment="Center"
                FontWeight="Bold"
                Text="{Binding [sF_OPTIONS_LB22]}" />
            <ComboBox
                x:Name="RingBox"
                Grid.Row="9"
                Grid.Column="1"
                SelectionChanged="Ring_Changed" />
        </Grid>
    </ScrollViewer>
</Page>
