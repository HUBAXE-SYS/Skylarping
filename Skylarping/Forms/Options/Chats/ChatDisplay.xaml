    How AI output is shown in chat. Shared by Options > Chats & SMS > Chat appearance
    and Tools > AI Services > Chat display. Changes apply immediately, like the rest of Options.
-->
<Page
    x:Class="Skylarping.Forms.OptionPages.Chats.ChatDisplay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="#FFFFFF"
    d:Height="505"
    d:Width="514"
    FontFamily="Tahoma"
    FontSize="11"
    Foreground="{DynamicResource Text.VeryHighContrast}"
    Style="{StaticResource Page}"
    mc:Ignorable="d">

    <ScrollViewer Margin="10">
        <StackPanel Orientation="Vertical">

            <TextBlock Margin="0,0,0,4" FontWeight="Bold" Text="Formatting" />
            <StackPanel Margin="0,5" Orientation="Horizontal">
                <CheckBox
                    x:Name="MarkdownBox"
                    Padding="6,0"
                    Checked="MarkdownBox_Changed"
                    Content="Format messages with Markdown (bold, lists, code blocks, tables)"
                    Foreground="{DynamicResource Text.VeryHighContrast}"
                    Unchecked="MarkdownBox_Changed" />
            </StackPanel>
            <TextBlock
                Margin="22,0,0,0"
                Foreground="{DynamicResource Text.MediumContrast}"
                Text="When off, messages are shown as plain text. Emoticons and links still work."
                TextWrapping="Wrap" />

            <Separator Margin="2,10,5,8" Foreground="{DynamicResource Separator}" />
            <TextBlock Margin="0,0,0,4" FontWeight="Bold" Text="Character replies" />
            <StackPanel Margin="0,5" Orientation="Horizontal">
                <CheckBox
                    x:Name="StreamBox"
                    Padding="6,0"
                    Checked="Toggle_Changed"
                    Content="Show replies as they're being written (streaming)"
                    Foreground="{DynamicResource Text.VeryHighContrast}"
                    Unchecked="Toggle_Changed" />
            </StackPanel>
            <TextBlock
                Margin="22,0,0,0"
                Foreground="{DynamicResource Text.MediumContrast}"
                Text="When off, a reply appears all at once when it's finished. Streaming can be slower on old computers."
                TextWrapping="Wrap" />

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <CheckBox
                    x:Name="EditBox"
                    Padding="6,0"
                    Checked="Toggle_Changed"
                    Content="Show Edit Message and Remove Message in the message menu"
                    Foreground="{DynamicResource Text.VeryHighContrast}"
                    Unchecked="Toggle_Changed" />
            </StackPanel>
            <TextBlock
                Margin="22,0,0,0"
                Foreground="{DynamicResource Text.MediumContrast}"
                Text="Right-click a message in a character chat to change or remove it. The character remembers the edited conversation."
                TextWrapping="Wrap" />

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <CheckBox
                    x:Name="RegenerateBox"
                    Padding="6,0"
                    Checked="Toggle_Changed"
                    Content="Show Regenerate Reply in the message menu"
                    Foreground="{DynamicResource Text.VeryHighContrast}"
                    Unchecked="Toggle_Changed" />
            </StackPanel>
            <TextBlock
                Margin="22,0,0,0"
                Foreground="{DynamicResource Text.MediumContrast}"
                Text="Right-click a character's latest reply to get a different one."
                TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</Page>
