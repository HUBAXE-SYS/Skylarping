<Page
    x:Class="Skylarping.Forms.OptionPages.Placeholder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Skylarping.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:global="clr-namespace:Skylarping"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:preferences="clr-namespace:Skylarping.Preferences"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    d:Background="#FFFFFF"
    d:Height="505"
    d:Width="514"
    DataContext="{StaticResource Lang}"
    FontFamily="Tahoma"
    FontSize="11"
    Foreground="{DynamicResource Text.VeryHighContrast}"
    Style="{StaticResource Page}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Width="350"
            Margin="50"
            Text="This feature is not implemented yet."
            TextWrapping="Wrap" />

        <Image
            Grid.Row="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Source="/Themes/Skype4/Assets/Universal/Home/footer.png" />
    </Grid>
</Page>
