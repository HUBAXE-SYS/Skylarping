<Page
    x:Class="Skylarping.Forms.AIServicePages.LanguageModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:Skylarping.UserControls"
    d:Background="#FFFFFF"
    d:Height="505"
    d:Width="514"
    FontFamily="Tahoma"
    FontSize="11"
    Foreground="{DynamicResource Text.VeryHighContrast}"
    Style="{StaticResource Page}"
    mc:Ignorable="d">

    <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical">

            <TextBlock Margin="0,0,0,3" Text="LLM Server URL (http://ip:port/v1):" />
            <TextBox
                x:Name="ServerBox"
                Margin="0,0,0,8"
                FontFamily="Tahoma"
                TextChanged="Field_Changed" />

            <TextBlock Margin="0,0,0,3" Text="API Key (leave blank if your server doesn't need one):" />
            <PasswordBox
                x:Name="ApiKeyBox"
                Margin="0,0,0,8"
                FontFamily="Tahoma"
                PasswordChanged="Field_Changed" />

            <TextBlock Margin="0,0,0,3" Text="Model:" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="ModelBox"
                    Grid.Column="0"
                    FontFamily="Tahoma"
                    TextChanged="Field_Changed" />
                <Button
                    Grid.Column="1"
                    Height="21"
                    MinWidth="85"
                    Margin="6,0,0,0"
                    Padding="8,0"
                    Click="ModelListButton_Click"
                    Content="Model List..." />
            </Grid>

            <TextBlock Margin="0,0,0,3" Text="Context window (tokens, 0 = unknown):" />
            <TextBox
                x:Name="ContextBox"
                Width="100"
                Margin="0,0,0,12"
                HorizontalAlignment="Left"
                FontFamily="Tahoma"
                TextChanged="Field_Changed" />

            <Separator Margin="2,0,5,8" Foreground="{DynamicResource Separator}" />

            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <Button
                    x:Name="TestButton"
                    Height="23"
                    MinWidth="110"
                    Padding="12,0"
                    Click="TestButton_Click"
                    Content="Test Connection" />
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Text.MediumContrast}"
                    Text="Tests what's typed above, before you save." />
            </StackPanel>
            <uc:ConnectionTestView x:Name="TestView" />

        </StackPanel>
    </ScrollViewer>
</Page>
