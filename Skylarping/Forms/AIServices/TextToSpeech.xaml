<Page
    x:Class="Skylarping.Forms.AIServicePages.TextToSpeech"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:Skylarping.UserControls"
    d:Background="#FFFFFF"
    d:Height="505"
    d:Width="514"
    FontFamily="Tahoma"
    FontSize="11"
    Foreground="{DynamicResource Text.VeryHighContrast}"
    Style="{StaticResource Page}"
    mc:Ignorable="d">

    <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical">

            <TextBlock Margin="0,0,0,3" Text="Text-to-Speech Server URL (http://ip:port/v1):" />
            <TextBox
                x:Name="ServerBox"
                Margin="0,0,0,3"
                FontFamily="Tahoma"
                TextChanged="Field_Changed" />
            <TextBlock
                Margin="0,0,0,8"
                Foreground="{DynamicResource Text.MediumContrast}"
                Text="Leave blank to use your language model server and its API key."
                TextWrapping="Wrap" />

            <TextBlock Margin="0,0,0,3" Text="API Key (leave blank if your server doesn't need one):" />
            <PasswordBox
                x:Name="ApiKeyBox"
                Margin="0,0,0,8"
                FontFamily="Tahoma"
                PasswordChanged="Field_Changed" />

            <TextBlock Margin="0,0,0,3" Text="Model (leave blank for characters to stay silent on calls):" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="ModelBox"
                    Grid.Column="0"
                    FontFamily="Tahoma"
                    TextChanged="Field_Changed" />
                <Button
                    Grid.Column="1"
                    Height="21"
                    MinWidth="85"
                    Margin="6,0,0,0"
                    Padding="8,0"
                    Click="ModelListButton_Click"
                    Content="Model List..." />
            </Grid>

            <TextBlock Margin="0,0,0,3" Text="Speed (percent, 100 is normal):" />
            <TextBox
                x:Name="SpeedBox"
                Width="100"
                Margin="0,0,0,8"
                HorizontalAlignment="Left"
                FontFamily="Tahoma"
                TextChanged="Field_Changed" />

            <CheckBox
                x:Name="InterruptionBox"
                Margin="0,0,0,3"
                Content="Let me interrupt the character by talking" />
            <TextBlock
                Margin="0,0,0,12"
                Foreground="{DynamicResource Text.MediumContrast}"
                Text="If a character keeps cutting itself off, turn this off. They'll then finish speaking before you're heard."
                TextWrapping="Wrap" />

            <Separator Margin="2,0,5,8" Foreground="{DynamicResource Separator}" />

            <uc:VoiceTestView x:Name="TestView" />

        </StackPanel>
    </ScrollViewer>
</Page>
