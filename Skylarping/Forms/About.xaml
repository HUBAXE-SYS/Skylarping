<Window
    x:Class="Skylarping.Forms.About"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Skylarping.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:global="clr-namespace:Skylarping"
    xmlns:io="clr-namespace:System.Runtime.InteropServices;assembly=System.Runtime.InteropServices.RuntimeInformation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:preferences="clr-namespace:Skylarping.Preferences"
    Title="About"
    Width="501"
    Height="454"
    AllowsTransparency="True"
    Style="{StaticResource Window}"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>

        <converters:AssetLoader x:Key="AssetLoader" />
    </Window.Resources>
    <Window.Background>
        <ImageBrush ImageSource="{Binding Converter={StaticResource AssetLoader}, Source='Assets/Themeable/backgrounds/about.png'}" Stretch="Uniform" />
    </Window.Background>
    <StackPanel>
        <Image
            Height="108"
            Margin="0,115,0,3"
            Source="{Binding Converter={StaticResource AssetLoader}, Source='Assets/Universal/Branding/logo-about.png'}" />
        <TextBlock
            Margin="0,1,9,0"
            HorizontalAlignment="Center"
            FontFamily="Arial"
            FontSize="20"
            FontWeight="Bold"
            Foreground="{DynamicResource Text.HighContrast}"
            Text="Take another breath" />
        <TextBlock
            x:Name="BuildVersion"
            Margin="0,3,9,-6"
            HorizontalAlignment="Center"
            FontFamily="Arial"
            FontSize="13"
            FontWeight="Bold"
            Foreground="#555555">
            <TextBlock.Text>
                <MultiBinding StringFormat="v{0} {1}">
                    <Binding Source="{x:Static global:Universal.BUILD_VERSION}" />
                    <Binding Source="{x:Static global:Universal.BUILD_NAME}" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
        <TextBlock
            Width="390"
            Margin="0,23,10,0"
            HorizontalAlignment="Center"
            FontFamily="Tahoma"
            FontSize="11"
            Foreground="#363636"
            LineHeight="16"
            Text="Open-source software under the AGPL v3: https://github.com/randomNinja64/Skylarping&#x0a;Skylarping is based on Skymu by The Skymu Team and other contributors.&#x0a;Skylarping is not associated with Skype or Microsoft. However, Skylarping contains assets created by Skype Limited and employed under fair use."
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <TextBlock
            Width="390"
            Margin="0,10,10,0"
            HorizontalAlignment="Center"
            FontFamily="Tahoma"
            FontSize="11"
            Foreground="#363636"
            LineHeight="16"
            Text="Skylarping is an AI character chat client that faithfully recreates the user interface and experience of Skype 4.&#x0a;It runs on Windows XP and later."
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <TextBlock
            Width="390"
            Margin="0,10,10,0"
            HorizontalAlignment="Center"
            FontFamily="Tahoma"
            FontSize="11"
            Foreground="#888888"
            LineHeight="16"
            TextAlignment="Center"
            TextWrapping="Wrap">
            <TextBlock.Text>
                <MultiBinding StringFormat="Common Language Runtime: {0} on {1}">
                    <Binding Source="{x:Static global:Universal.NetVersion}" />
                    <Binding Source="{x:Static global:Universal.Platform}" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
    </StackPanel>
</Window>