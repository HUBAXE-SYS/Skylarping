<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

	<!-- Main thingy -->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>true</UseWPF>
		<IsWebBootstrapper>false</IsWebBootstrapper>
		<PublishUrl>publish\</PublishUrl>
		<Install>true</Install>
		<InstallFrom>Disk</InstallFrom>
		<UpdateEnabled>false</UpdateEnabled>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<IntermediateOutputPath>obj\$(TargetFramework)\$(Configuration)\</IntermediateOutputPath>
		<UpdateMode>Foreground</UpdateMode>
		<UpdateInterval>7</UpdateInterval>
		<UpdateIntervalUnits>Days</UpdateIntervalUnits>
		<UpdatePeriodically>false</UpdatePeriodically>
		<UpdateRequired>false</UpdateRequired>
		<MapFileExtensions>true</MapFileExtensions>
		<ApplicationRevision>0</ApplicationRevision>
		<ApplicationVersion>1.0.0.*</ApplicationVersion>
		<UseApplicationTrust>false</UseApplicationTrust>
		<BootstrapperEnabled>true</BootstrapperEnabled>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<NoWarn>$(NoWarn);NETSDK1138</NoWarn>
		<StartupObject />
		<Win32Resource>Icons\SKYPE5.res</Win32Resource>
		<LangVersion>7.3</LangVersion>
		<SubsystemVersion>5.00</SubsystemVersion>
	</PropertyGroup>

	<!-- Assembly information -->
	<PropertyGroup>
		<AssemblyTitle>Skylarping</AssemblyTitle>
		<Description>Skylarping</Description>
		<FileDescription>Skylarping</FileDescription>
		<Company>The Skylarping Team</Company>
		<Product>Skylarping</Product>
	</PropertyGroup>

	<!-- Target framework: .NET Framework 4.0 (last version supported on Windows XP) -->
	<PropertyGroup>
		<TargetFramework>net40</TargetFramework>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<OutputPath>bin\$(Configuration)\</OutputPath>
	</PropertyGroup>

	<!-- Build configurations -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugType>none</DebugType>
		<Optimize>true</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
	</PropertyGroup>

	<!-- Resource Handling -->
	<ItemGroup>
		<!-- Themes -->
		<Resource Include="Themes\Skype4\Assets\**\*" />
		<Resource Include="Themes\Skype5\Assets\**\*" />
		<Resource Include="Themes\Skype6\Assets\**\*" />

		<!-- Emoji -->
		<None Remove="Emoji\**\*" />
		<None Remove="Properties\**" />
		<Page Remove="Emoji\**\*" />
		<EmbeddedResource Remove="Emoji\Resources\**\*" />
		<Compile Remove="Emoji\**\*" />
		<Resource Include="Emoji\**\*" />

		<!-- Sounds -->
		<None Remove="Sounds*\**\*" />
		<Page Remove="Properties\**" />
		<Page Remove="Sounds*\**\*" />
		<EmbeddedResource Remove="Properties\**" />
		<EmbeddedResource Remove="Sounds*\**\*" />
		<Compile Remove="Properties\**" />
		<Compile Remove="Sounds*\**\*" />
		<Resource Include="Sounds*\**\*" />

		<!-- Languages as Content -->
		<None Remove="Languages\**\*" />
		<Page Remove="Languages\**\*" />
		<EmbeddedResource Remove="Languages\**\*" />
		<Compile Remove="Languages\**\*" />
		<Content Include="Languages\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		
	</ItemGroup>
	<ItemGroup>
		<Resource Remove="Properties\**" />
	</ItemGroup>

	<!-- Packages -->
	<ItemGroup>
		<PackageReference Include="Markdig" Version="0.18.3" />
		<PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

	<!-- SpeexDSP (echo cancellation for calls, used through Skylarping/Audio). Built by ThirdParty/speexdsp/build.sh -->
	<ItemGroup>
		<None Include="..\ThirdParty\speexdsp\prebuilt\x86\libspeexdsp.dll" Link="x86\libspeexdsp.dll" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\ThirdParty\speexdsp\prebuilt\x64\libspeexdsp.dll" Link="x64\libspeexdsp.dll" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\ThirdParty\speexdsp\COPYING" Link="THIRD_PARTY_LICENSES\speexdsp.txt" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- License notices for NuGet packages whose licenses require them in binary distributions -->
	<ItemGroup>
		<None Include="..\ThirdParty\licenses\markdig.txt" Link="THIRD_PARTY_LICENSES\markdig.txt" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\ThirdParty\licenses\Newtonsoft.Json.txt" Link="THIRD_PARTY_LICENSES\Newtonsoft.Json.txt" CopyToOutputDirectory="PreserveNewest" />
		<!-- Files derived from the Yggdrasil API (Skylarping/Models, Skylarping/Backend) are Apache-2.0 -->
		<None Include="..\ThirdParty\licenses\Yggdrasil-Apache-2.0.txt" Link="THIRD_PARTY_LICENSES\Yggdrasil-Apache-2.0.txt" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- NAudio 2.2.1 (MIT) built from source for .NET 4.0, see ThirdParty/naudio -->
	<ItemGroup>
		<ProjectReference Include="..\ThirdParty\naudio\NAudio.csproj" />
		<None Include="..\ThirdParty\naudio\license.txt" Link="THIRD_PARTY_LICENSES\naudio.txt" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- libfvad (voice activity detection for calls, used through Skylarping/Audio). Built by ThirdParty/libfvad/build.sh -->
	<ItemGroup>
		<None Include="..\ThirdParty\libfvad\prebuilt\x86\libfvad.dll" Link="x86\libfvad.dll" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\ThirdParty\libfvad\prebuilt\x64\libfvad.dll" Link="x64\libfvad.dll" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\ThirdParty\libfvad\LICENSE" Link="THIRD_PARTY_LICENSES\libfvad.txt" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\ThirdParty\libfvad\PATENTS" Link="THIRD_PARTY_LICENSES\libfvad-PATENTS.txt" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- Optional SimpleLLMChat-compatible tool packages (not part of the repo): whatever is in
	     deps\tools\<package>\ is copied to tools\<package>\ next to the exe, so dev builds and
	     tests see the same tools build.bat packages. Nothing there = no tools, which is fine. -->
	<ItemGroup>
		<None Include="..\deps\tools\**\*" Link="tools\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
		<!-- WebTools' own dependencies, packaged next to it like SimpleLLMChat's build.bat does
		     (curl + CA bundle for fetching/search, yt-dlp for media downloads). Each is optional. -->
		<None Include="..\deps\curl.exe" Link="tools\WebTools\curl.exe" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('..\deps\tools\WebTools') And Exists('..\deps\curl.exe')" />
		<None Include="..\deps\curl-ca-bundle.crt" Link="tools\WebTools\curl-ca-bundle.crt" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('..\deps\tools\WebTools') And Exists('..\deps\curl-ca-bundle.crt')" />
		<None Include="..\deps\yt-dlp.exe" Link="tools\WebTools\yt-dlp.exe" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('..\deps\tools\WebTools') And Exists('..\deps\yt-dlp.exe')" />
		<!-- Skylarping's own tool option defaults (ships even without tools). See AI/Tools/ToolRegistry.cs -->
		<None Update="ToolDefaults.ini" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Microsoft.CSharp" />
		<!-- WPF themes are part of .NET Framework 4 (in the GAC); don't ship copies of Microsoft's binaries. -->
		<Reference Include="PresentationFramework.Aero">
			<Private>False</Private>
		</Reference>
		<Reference Include="PresentationFramework.Classic">
			<Private>False</Private>
		</Reference>
		<Reference Include="PresentationFramework.Luna">
			<Private>False</Private>
		</Reference>
		<Reference Include="PresentationFramework.Royale">
			<Private>False</Private>
		</Reference>
		<Reference Include="System.Security" />
		<Reference Include="System.Web" />
	</ItemGroup>

	<ItemGroup>
		<AppDesigner Include="Properties\" />
	</ItemGroup>

	<ItemGroup>
		<BootstrapperPackage Include=".NETFramework,Version=v4.0">
			<Visible>False</Visible>
			<ProductName>.NET Framework 4</ProductName>
			<Install>true</Install>
		</BootstrapperPackage>
	</ItemGroup>

	<ItemGroup>
		<Page Include="App.xaml" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Colorways\default.xaml">
			<Generator>MSBuild:Compile</Generator>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Shaders\DarkenLighten.ps" />
	  <Resource Include="Shaders\DarkenLighten.ps" />
	</ItemGroup>

</Project>
